# Flask Application Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Upload & Resource Limits Configuration
# Note: On Vercel serverless deployment, MAX_CONTENT_LENGTH defaults to 4MB (4194304 bytes) below Vercel payload limits.
# On local/Gunicorn deployment, 16MB (16777216 bytes) is used.
MAX_CONTENT_LENGTH=16777216  # 16MB limit in bytes (local/Gunicorn)
UPLOAD_FOLDER=uploads
MAX_JD_LENGTH=10000          # 10,000 max character job description limit
MAX_PDF_PAGES=50             # 50 max page PDF document limit

# AI/NLP Intelligence Model Configuration
# Note: On Vercel (VERCEL=1), the app automatically uses lightweight Jaccard token fallback mode.
# NLP_MODEL_NAME is used for local/containerized SentenceTransformer deployments.
NLP_MODEL_NAME=all-MiniLM-L6-v2  # Sentence Transformers pretrained model
EMBEDDING_CACHE_SIZE=2000        # Thread-safe in-memory vector LRU cache limit

# Security Cookie Configuration
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
